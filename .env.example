# Public link to the current resume. The site opens this in a new tab, so the
# resume can be updated without a code change. Set this in .env.local for local
# dev, and as a repository variable for the GitHub Actions build. If unset, the
# site falls back to resumeFallbackUrl in src/data/site.json instead of hiding
# the Resume button.
NEXT_PUBLIC_RESUME_URL=https://drive.google.com/file/d/1Q6aHAMRMlef_HT59oVHJCgoEpQXvvR4h/view?usp=drive_link
